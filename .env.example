# Copy to ".env" (never commit .env). Lines starting with # are comments.
# Required in production are marked [REQUIRED]. Everything else has a safe default.

# ---- Core ----
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# [REQUIRED] Public https address of the site, no trailing slash. Used in links, cookies, redirects.
PUBLIC_BASE_URL=https://salon.example.com
# [REQUIRED] Random secret, at least 32 chars. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# How many reverse proxies sit in front (Caddy / Render / Railway = 1; running directly = 0).
TRUST_PROXY=1

# ---- Database (PostgreSQL) ----
# [REQUIRED] e.g. postgres://user:password@host:5432/dbname   (docker-compose sets this for you)
DATABASE_URL=
# off | require | no-verify    (managed databases usually need "require")
DATABASE_SSL=off
DB_POOL_MAX=10
# Run pending migrations on start (recommended).
AUTO_MIGRATE=true
# docker-compose only: password for the bundled Postgres, and your domain for Caddy.
POSTGRES_PASSWORD=
DOMAIN=salon.example.com

# ---- First administrator (created on first start if no admin exists) ----
# Password: at least 12 characters, not common, 2+ character types. Remove ADMIN_PASSWORD from .env afterwards.
ADMIN_EMAIL=
ADMIN_NAME=店主
ADMIN_PASSWORD=

# ---- Business details shown on the site (leave blank = shown as "待填"; never invented) ----
STORE_NAME=
STORE_ADDRESS=
STORE_PHONE=
STORE_WHATSAPP=
STORE_HOURS=
BUSINESS_REG_NO=

# ---- Demo / sample data (keep both false in production) ----
SITE_DEMO_MODE=false
SEED_DEMO_DATA=false

# ---- Sessions, passwords, retention ----
SESSION_TTL_HOURS_STAFF=8
SESSION_TTL_HOURS_CUSTOMER=72
RESET_TOKEN_TTL_MINUTES=60
INVITE_TTL_HOURS=72
LOCKOUT_THRESHOLD=5
DATA_RETENTION_MONTHS=24
LOG_LEVEL=info

# ---- Stripe (10-session package, HK$8,800) ----
# test = Stripe Test Mode (default). To take REAL payments you must set ALL THREE: STRIPE_MODE=live, STRIPE_ALLOW_LIVE=yes, and an sk_live_ key.
STRIPE_MODE=test
STRIPE_ALLOW_LIVE=no
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your domain>/api/stripe/webhook  (starts with whsec_)
STRIPE_WEBHOOK_SECRET=

# ---- Password-reset e-mail and booking notifications ----
# none | smtp | sendgrid.   Without a provider, reset links are written to the server log only.
EMAIL_PROVIDER=none
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
# Master switch for sending REAL customer messages. Default false = drafts only.
NOTIFY_ENABLED=false
NOTIFY_EMAIL=true
NOTIFY_WHATSAPP=false
# true = record what would be sent but send nothing (use while testing).
NOTIFY_DRY_RUN=false
# Comma-separated addresses; when set, ONLY these receive messages (pilot protection).
NOTIFY_TEST_ALLOWLIST=
# WhatsApp Business Cloud API (approved TEMPLATE messages only)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=zh_HK
WHATSAPP_TEMPLATE_CONFIRMATION=
WHATSAPP_TEMPLATE_REMINDER=
